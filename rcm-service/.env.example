#QDRANT
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=products_kb

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Preferred: PostgreSQL DSN
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_pharma

# PostgreSQL fallback (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_pharma
DB_USER=postgres
DB_PASSWORD=password

# RCM routing and blending
# Số ngày dùng để tính xu hướng gần đây cho homepage.
RCM_TREND_WINDOW_DAYS=14
# Hệ số suy giảm theo thời gian cho hành vi cũ: càng lớn thì dữ liệu cũ càng giảm trọng số nhanh hơn.
RCM_TREND_DECAY_LAMBDA=0.12
# Ngưỡng số sản phẩm khác nhau tối thiểu để coi lịch sử người dùng là đủ giàu tín hiệu.
RCM_HISTORY_MIN_DISTINCT_ENOUGH=3
# Trọng số content-based trên homepage khi lịch sử còn ít tín hiệu.
RCM_BLEND_HOME_LIGHT_CONTENT=0.65
# Trọng số trend-based trên homepage khi lịch sử còn ít tín hiệu.
RCM_BLEND_HOME_LIGHT_TREND=0.35
# Trọng số collaborative filtering trên homepage khi lịch sử đủ giàu tín hiệu.
RCM_BLEND_HOME_ENOUGH_CF=0.55
# Trọng số content-based trên homepage khi lịch sử đủ giàu tín hiệu.
RCM_BLEND_HOME_ENOUGH_CONTENT=0.45
# Trọng số content-based ở trang chi tiết sản phẩm.
RCM_BLEND_DETAIL_CONTENT=0.7
# Trọng số collaborative filtering ở trang chi tiết sản phẩm.
RCM_BLEND_DETAIL_CF=0.3

# Internal auth from backend
RCM_INTERNAL_JWT_SECRET=change_me_shared_rcm_internal_secret
RCM_INTERNAL_JWT_ISSUER=smart-pharma-backend
RCM_INTERNAL_JWT_AUDIENCE=rcm-service
